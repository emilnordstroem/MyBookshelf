@model MyBookshelf.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details | <a asp-action="Index">Back</a></h1>

<div>
    <h4>
        @Html.DisplayFor(model => model.Title)
    </h4>
    <hr />
    <div>
        <div>
            @Html.DisplayNameFor(model => model.Authors): @string.Join(", ", Model.Authors)
        </div>
        <div>
            @Html.DisplayNameFor(model => model.Publisher): @Html.DisplayFor(model => model.Publisher) [@Html.DisplayFor(model => model.Published.Year)]
        </div>
    </div>
    <hr />
    <div>
        <div>
            @Html.DisplayNameFor(model => model.Rating): @Html.DisplayFor(model => model.Rating) / 5
        </div>
        <div>
            @Html.DisplayNameFor(model => model.Comment)
            @Html.TextAreaFor(model => model.Comment)

        </div>
    </div>
</div>
